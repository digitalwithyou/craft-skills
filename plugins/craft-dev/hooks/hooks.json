{
  "description": "Craft/DDEV guard: tooling runs through ddev; hand edits to Project Config YAML need confirmation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
